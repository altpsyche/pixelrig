{
  "name": "Run",
  "rig": "humanoid",
  "frames": 12,
  "fps": 12,
  "loop": true,
  "comment": "Angles in degrees. leg.thigh/arm.shoulder: from straight down, + = forward. leg.knee: bend (shin swings back). arm.elbow: bend (forearm swings forward). leg.foot: toe pitch, + = toes down. torso.lean: from vertical, + = forward. root.lift: feet-off-ground height in body units. Sided channels (leg.*, arm.*) are authored for the near side; far side samples them at t + sideOffset.",
  "sided": [ "leg", "arm" ],
  "sideOffset": 0.5,
  "interp": "smooth",
  "channels": {
    "root.lift":  { "repeat": 2, "keys": [[0, 0], [0.167, 0], [0.333, 0], [0.5, 0], [0.667, 0.035], [0.833, 0.025]] },
    "torso.lean": { "repeat": 2, "keys": [[0, 10], [0.167, 13], [0.5, 8], [0.75, 9]] },
    "head.tilt":  { "keys": [[0, -6]] },

    "leg.thigh": { "keys": [[0, 30], [0.083, 12], [0.167, -8], [0.25, -32], [0.333, -30], [0.417, -18],
                            [0.5, -12], [0.583, 15], [0.667, 42], [0.75, 55], [0.833, 50], [0.917, 40]] },
    "leg.knee":  { "keys": [[0, 12], [0.083, 55], [0.167, 28], [0.25, 12], [0.333, 80], [0.417, 110],
                            [0.5, 120], [0.583, 125], [0.667, 110], [0.75, 85], [0.833, 50], [0.917, 22]] },
    "leg.foot":  { "keys": [[0, -8], [0.083, 0], [0.167, 0], [0.25, 45], [0.333, 50], [0.417, 45],
                            [0.5, 30], [0.583, 15], [0.667, 5], [0.75, -5], [0.833, -10], [0.917, -10]] },

    "arm.shoulder": { "keys": [[0, -40], [0.25, 0], [0.5, 45], [0.75, 5]] },
    "arm.elbow":    { "keys": [[0, 70], [0.25, 85], [0.5, 100], [0.75, 85]] }
  },
  "params": [
    { "id": "stride",   "label": "Stride %",     "min": 0,   "max": 200, "default": 100, "op": "scale", "channels": ["leg.thigh"] },
    { "id": "kneeDrive","label": "Knee drive %", "min": 0,   "max": 200, "default": 100, "op": "scale", "channels": ["leg.knee"] },
    { "id": "bounce",   "label": "Bounce %",     "min": 0,   "max": 300, "default": 100, "op": "scale", "channels": ["root.lift"] },
    { "id": "lean",     "label": "Lean +deg",    "min": -20, "max": 30,  "default": 0,   "op": "add",   "channels": ["torso.lean"] },
    { "id": "armSwing", "label": "Arm swing %",  "min": 0,   "max": 200, "default": 100, "op": "scale", "channels": ["arm.shoulder"] }
  ],
  "marks": [
    { "t": 0.0,   "name": "contact" },
    { "t": 0.083, "name": "down" },
    { "t": 0.167, "name": "pass" },
    { "t": 0.25,  "name": "up" },
    { "t": 0.333, "name": "flight" },
    { "t": 0.5,   "name": "contact" },
    { "t": 0.583, "name": "down" },
    { "t": 0.667, "name": "pass" },
    { "t": 0.75,  "name": "up" },
    { "t": 0.833, "name": "flight" }
  ]
}
